{
  "name": "applicable",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "proof:generate": "node --experimental-strip-types proof/generate.mjs",
    "proof:serve": "node --experimental-strip-types proof/serve.mjs",
    "test": "node --experimental-strip-types --test proof/render.test.mjs tests/parser.test.mjs tests/contact.test.mjs tests/production-pdf.test.mjs tests/download-filename.test.mjs tests/agent-usage.test.mjs tests/build-notices.test.mjs tests/job-finder.test.mjs tests/resume-writer.test.mjs",
    "test:browser": "node tests/run-browser.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm test && npm run build && npm run test:browser",
    "fonts:coverage": "node --experimental-strip-types scripts/font-coverage.mjs",
    "usage:snapshot": "node scripts/agent-usage.mjs snapshot",
    "usage:start": "node scripts/agent-usage.mjs start",
    "usage:finish": "node scripts/agent-usage.mjs finish",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:fix": "eslint . --fix",
    "prepare": "node scripts/prepare-hooks.mjs"
  },
  "dependencies": {
    "pdfmake": "0.2.20",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/pdfmake": "0.2.13",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/parser": "8.71.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "pdfjs-dist": "4.10.38",
    "playwright": "1.62.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,json,css,html,md,yml,yaml}": "prettier --write --ignore-unknown"
  }
}
